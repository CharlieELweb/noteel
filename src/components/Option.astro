---
interface Props {
	answer?: boolean
}
const { answer = false } = Astro.props
---

<label class="option not-content button" data-answer={answer}>
	<input type="radio" name="option" />
	<slot />
</label>

<style>
	.option {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	input[type="radio"] {
		appearance: none;
	}
	.option:not(.correct, .incorrect):has(input:checked) {
		--color-bg: var(--sl-color-secondary-bg-low);
		--color-border: var(--sl-color-secondary);
		color: var(--sl-color-secondary);
	}
	.option.correct {
		--color-bg: var(--sl-color-green-low);
		--color-border: var(--sl-color-green);
		color: var(--sl-color-green);
		animation: jump 0.5s ease;
	}
	.option.incorrect {
		--color-bg: var(--sl-color-red-low);
		--color-border: var(--sl-color-red);
		color: var(--sl-color-red);
		animation: shake 0.3s ease;
	}
</style>
