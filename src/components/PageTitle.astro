---
import MyIcon from "./MyIcon.astro"
---


<div class="page-title" id="_top">
	<div class="page-title-content">
		<p class="eyebrow">{Astro.locals.starlightRoute.entry.data.eyebrow}</p>
		<h1>{Astro.locals.starlightRoute.entry.data.title}</h1>
		<p>{Astro.locals.starlightRoute.entry.data.description}</p>
		<div class="icon">
			{
				Astro.locals.starlightRoute.entry.data.icon && (
					<MyIcon
						name={Astro.locals.starlightRoute.entry.data.icon}
						size="clamp(10em, 40vw, 20em)"
						fill
					/>
				)
			}
		</div>
	</div>
</div>

{Astro.locals.starlightRoute.entry.data.template != "splash" && (
<style>
	.page-title {
		position: relative;
	}
	.page-title .icon {
		position: absolute;
		bottom: -75%;
		right: 0;
		color: var(--sl-color-secondary-bg-high);
	}
	.page-title-content p {
		z-index: 100;
	}
	.page-title-content p.eyebrow {
		font-weight: 500;
		color: var(--sl-color-gray-2);
	}
	.page-title-content h1 {
		z-index: 100;
		margin-top: 0;
		margin-bottom: var(--gap-xl);
	}
		.page-title-content {
			display: flex;
			flex-direction: column;
			margin: var(--gap-xxxl) 0;
		}
		.page-title-content h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
			width: 100%;
		}
		@media (min-width: 50rem) {
			.page-title-content h1,
			.page-title-content p {
				width: 75%;
			}
		}
		.page-title-content p {
			margin-top: 1rem;
			font-size: var(--sl-text-h4);
			line-height: var(--sl-line-height-headings);
			color: var(--sl-color-white);
		}
</style>
)
}